#!/bin/bash

# NOTE both do not end with a slash.
SRC="${1:-$HOME/rigi/bv2}"
DST1="${2:-fair-sc:~/rigi/bv2}"
DST2="$3"
[[ $# -le 1 ]] && DST2="fair-sc-3:~/rigi/bv2"

# ENSURE that both do not end with a slash.
SRC="${SRC%/}"
DST1="${DST1%/}"
DST2="${DST2%/}"
# However, below we'll always USE SRC with a slash and DST without.

# Put common excludes in an array (easy to extend)
EXCLUDES=(
  --exclude='.git/'
  --exclude='__pycache__/'
  --exclude='/venv*/'
)

sync_once() {
  rsync -az --delete --checksum "${EXCLUDES[@]}" "$SRC/" "$DST1"
  [[ -n "$DST2" ]] && rsync -az --delete --checksum "${EXCLUDES[@]}" "$SRC/" "$DST2"
  echo "Files synchronized at $(date)"
}

sync_once

watch_for_changes() {
  # Linux systems have `inotifywait` while macs have `notifywait`. This function unites them.
  if command -v inotifywait >/dev/null 2>&1; then
    inotifywait -r -e modify,create,delete,move "$1"
  elif command -v notifywait >/dev/null 2>&1; then
    notifywait "$1" >/dev/null
  else
    echo "Error: No supported watcher found."
    return 1
  fi
}

# Watch for modify/create/delete events recursively and rsync again on any event
while watch_for_changes "$SRC/"; do
  sync_once
done
