#!/usr/bin/env fish

set PROMPT_Y 'Yes, proceed (y)'
set PROMPT_ENTER_A 'Do you want to proceed?'
set PROMPT_ENTER_B '❯ 1. Yes'
set POLL 2.0    # seconds between checks
set DELAY 0.5   # seconds before sending response
set CAPTURE_BACK 30
set STATE_DIR (mktemp -d)

function cleanup --on-event fish_exit
    rm -rf "$STATE_DIR"
end

while true
    for pane_id in (tmux list-panes -a -F '#{pane_id}')
        set -l state_file "$STATE_DIR/"(string replace -a '%' '_' -- "$pane_id")
        set -l cursor_y (tmux display-message -p -t "$pane_id" '#{cursor_y}' 2>/dev/null)
        set -l start_y (math "$cursor_y - $CAPTURE_BACK")
        set -l lines (tmux capture-pane -t "$pane_id" -p -S "$start_y" -E "$cursor_y" 2>/dev/null | string match -rv '^[[:space:]]*$' | tail -n 10 | string collect)
        set -l action ''
        if string match -q -- "*$PROMPT_Y*" -- $lines
            set action y
        else if string match -q -- "*$PROMPT_ENTER_A*" -- $lines; and string match -q -- "*$PROMPT_ENTER_B*" -- $lines
            set action enter
        end
        if test -n "$action"
            set -l prev ''
            test -f "$state_file"; and set prev (cat "$state_file")
            if test "$lines" != "$prev"
                printf %s "$lines" > "$state_file"
                begin
                    sleep $DELAY
                    set -l cursor_y (tmux display-message -p -t "$pane_id" '#{cursor_y}' 2>/dev/null)
                    set -l start_y (math "$cursor_y - $CAPTURE_BACK")
                    set -l now (tmux capture-pane -t "$pane_id" -p -S "$start_y" -E "$cursor_y" 2>/dev/null | string match -rv '^[[:space:]]*$' | tail -n 10 | string collect)
                    if test "$now" = "$lines"
                        if test "$action" = y
                            tmux send-keys -t "$pane_id" y
                            echo "Said y in pane $pane_id at $(date)"
                        else
                            tmux send-keys -t "$pane_id" Enter
                            echo "Hit Enter in pane $pane_id at $(date)"
                        end
                    end
                end &
            end
        else
            # Prompt not on screen, so arm the next appearance.
            rm -f "$state_file"
        end
    end
    sleep $POLL
end
