#!/usr/bin/env fish

set CODEX_YES_RE '^\s*[›❯>]\s*1\.\s*Yes, proceed \(y\)\s*$'
set CODEX_FOOTER_RE '^\s*Press enter to confirm or esc to cancel\s*$'
set CLAUDE_Q_RE '^\s*Do you want to (proceed|create .+)\?\s*$'
set CLAUDE_YES_RE '^\s*[›❯>]\s*1\.\s*Yes\s*$'
set CLAUDE_FOOTER_RE '^\s*Esc to cancel\s*[·•]\s*Tab to amend.*$'
set CAPTURE_LINES 300
set PROMPT_LINES 16
set POLL 0.5
set POST_Y_SLEEP 1.0
set POST_ENTER_SLEEP 1.0

while true
    for pane_id in (tmux list-panes -a -F '#{pane_id}')
        set -l lines (tmux capture-pane -J -t "$pane_id" -p -S "-$CAPTURE_LINES" 2>/dev/null)
        test $status -ne 0; and continue
        set -l prompt_lines
        for i in (seq (count $lines) -1 1)
            string match -rq -- '\S' "$lines[$i]"; or continue
            set -a prompt_lines "$lines[$i]"
            test (count $prompt_lines) -ge $PROMPT_LINES; and break
        end
        test (count $prompt_lines) -eq 0; and continue
        set -l bottom "$prompt_lines[1]"
        if string match -rq -- $CODEX_FOOTER_RE "$bottom"; and printf '%s\n' $prompt_lines | string match -rq -- $CODEX_YES_RE
            tmux send-keys -t "$pane_id" y
            echo "Said y in pane $pane_id at $(date)"
            sleep $POST_Y_SLEEP
            continue
        end
        string match -rq -- $CLAUDE_FOOTER_RE "$bottom"; or continue
        printf '%s\n' $prompt_lines | string match -rq -- $CLAUDE_Q_RE; or continue
        printf '%s\n' $prompt_lines | string match -rq -- $CLAUDE_YES_RE; or continue
        tmux send-keys -t "$pane_id" Enter
        echo "Hit Enter in pane $pane_id at $(date)"
        sleep $POST_ENTER_SLEEP
    end
    sleep $POLL
end
