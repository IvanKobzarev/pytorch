#!/usr/bin/env fish

set PROMPT 'Yes, proceed (y)'
set POLL 2.0    # seconds between checks
set DELAY 0.5   # seconds before sending 'y'
set STATE_DIR (mktemp -d)

function cleanup --on-event fish_exit
    rm -rf "$STATE_DIR"
end

while true
    for pane_id in (tmux list-panes -a -F '#{pane_id}')
        set -l state_file "$STATE_DIR/"(string replace -a '%' '_' -- "$pane_id")
        set -l lines (tmux capture-pane -t "$pane_id" -p -S -10 2>/dev/null | string collect)
        if string match -q -- "*$PROMPT*" -- $lines
            set -l prev ''
            test -f "$state_file"; and set prev (cat "$state_file")
            if test "$lines" != "$prev"
                printf %s "$lines" > "$state_file"
                begin
                    sleep $DELAY
                    set -l now (tmux capture-pane -t "$pane_id" -p -S -10 2>/dev/null | string collect)
                    if test "$now" = "$lines"
                        tmux send-keys -t "$pane_id" y
                        echo "Said y in pane $pane_id at $(date)"
                    end
                end &
            end
        else
            # Prompt not on screen, so arm the next appearance.
            rm -f "$state_file"
        end
    end
    sleep $POLL
end
