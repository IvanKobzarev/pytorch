#!/bin/bash

set -euo pipefail

pids=()

forward_sig() {
  local sig=$1
  for pid in "${pids[@]:-}"; do
    if kill -0 "$pid" 2>/dev/null; then
      kill -s "$sig" "$pid" 2>/dev/null || true
    fi
  done
}

# The Ctrl+C is sent to everyone by default. In the launcher though, we want to wait for all
# the launched processes to exit naturally upon this, so we just print and that's it.
trap 'echo "Got SIGINT, hard-killing all kids immediately"; for p in "${pids[@]:-}"; do kill -9 "$p" 2>/dev/null || true; done' INT

# The SIGTERM on the other hand, we want to propagate to all children.
# It's also the signal SLURM sends before hard-killing you. So we forward, and wait.
trap 'echo "Got SIGTERM, forwarding to children"; forward_sig TERM; wait' TERM

# Optional: quiet NCCL a bit
export NCCL_DEBUG=WARN

# Optional: quiet torch profiler unwind exit spam
export KINETO_LOG_LEVEL=5
export TORCH_CPP_LOG_LEVEL=ERROR

if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  NGPUS=$(( $(tr -cd ',' <<<"$CUDA_VISIBLE_DEVICES" | wc -c) + 1 ))
else
  NGPUS=$(nvidia-smi -L | wc -l)
fi

export MASTER_ADDR=127.0.0.1
export MASTER_PORT=12355
export WORLD_SIZE=$NGPUS

# Run all processes in the background, except rank 0...
for (( local_rank=1; local_rank<NGPUS; local_rank++ )); do
  setsid env RANK=$local_rank LOCAL_RANK=$local_rank CUDA_VISIBLE_DEVICES=$local_rank python -u "$@" &
  pids+=($!)
done

# Run rank 0 in background too, but preserve stdin for pdb.
# This lets us use `wait` which allows traps to fire immediately.
RANK=0 LOCAL_RANK=0 CUDA_VISIBLE_DEVICES=0 python -u "$@" <&0 &
rank0_pid=$!
pids+=($rank0_pid)

# Wait for rank 0 to finish. Traps fire immediately during `wait`.
wait $rank0_pid && wait || for p in "${pids[@]:-}"; do kill -9 "$p" 2>/dev/null || true; done
