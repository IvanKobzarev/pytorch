#!/bin/bash
# NOTE: this needs to run from
#SBATCH --job-name=bv2-nightly
#SBATCH --account rigi
#SBATCH --qos h200_dev
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --gpus-per-node=2
#SBATCH --time=00:15:00
#SBATCH --output=/checkpoint/rigi/bv2/nightlies/z_run_%j.txt

WHICH_ONE=$(date +%y-%m-%d-%a_%H%M%S)

# SBATCH doesn't have something with date for filename, so we redirect.
exec > "/checkpoint/rigi/bv2/nightlies/${WHICH_ONE}_log.txt" 2>&1

echo "Start nightly at ${WHICH_ONE}"
cd ~/rigi-nightly

echo "Updating git..."
GIT_SSH_COMMAND='ssh -i ~/.ssh/github_readonly' git fetch origin
git clean -fd  # Remove any local untracked files which may inhibit branch switch.
git reset --hard  # Drop any changes on tracked files
git checkout -B main origin/main  # Go to main, whether it exists or not yet.

echo "Running GPU-based unit tests..."
python -m pytest -s bv2 -m gpu --json-report "--json-report-file=/checkpoint/rigi/bv2/nightlies/${WHICH_ONE}_tests_gpu.json"

echo "Running job..."
~/rigi/bv2/tools/launch_fair_srun -m bv2.train "name:=nightly_random_nouns_${WHICH_ONE}"

# Re-submit the job
echo "Rescheduling for in a day: $0"
sbatch --begin=now+1day "$0"

sleep 10
echo "Bye!"
