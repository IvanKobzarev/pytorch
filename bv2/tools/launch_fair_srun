#!/usr/bin/bash

# NOTES for scheduling: an 8 H200 machine has 192 CPUs and 2047959MB RAM
# The defaults set below are such that when requesting 8 GPUs, all CPUs and
# nearly all RAM is requested, so it's ~equivalent to asking for --exclusive
# but also allows easier scheduling when asking for less than 8 GPUs.
#
# Command to find out the node configurations and their counts:
# echo "COUNT  CPUs RAM (MB) GRES"; sinfo -N -o "%c %m %G" -p h200 | tail -n +2 | sort | uniq -c

#SBATCH --account=rigi
#SBATCH --cpus-per-gpu=24
#SBATCH --mem-per-gpu=255000
#SBATCH --time=7-0:0:0
#SBATCH --output=/checkpoint/rigi/bv2/slurm_out/%u/%j.txt
#SBATCH --open-mode=append
set -x

# We pick who's master and what port to use.
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((10000 + SLURM_JOB_ID % 50000))

# One task per GPU
NTASKS_PER_NODE=${SLURM_GPUS_ON_NODE:-8}

export NCCL_DEBUG=WARN  # quiet NCCL a bit

echo $CONDA_PREFIX
pwd

srun --ntasks-per-node=1 --ntasks="$SLURM_JOB_NUM_NODES" nvidia-smi topo -m

# The --unbuffered is needed if we want to live-tail the stdout/stderr logfile, otherwise it buffers aggressively.
srun \
  --unbuffered \
  --kill-on-bad-exit=1 \
  --ntasks-per-node="${NTASKS_PER_NODE}" \
  --cpus-per-task="$((SLURM_CPUS_ON_NODE / NTASKS_PER_NODE))" \
  python "$@" c.jid:="$SLURM_JOB_ID" c.gpus:="$((SLURM_GPUS_PER_NODE * SLURM_JOB_NUM_NODES))" c.gpu:="$SLURM_JOB_PARTITION"
