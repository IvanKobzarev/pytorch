#!/bin/bash
# How to run: Just run it. Just `devbox` you don't need to set options.

set -euo pipefail

PORT_NB=${PORT_NB:-8888}
PORT_FB=${PORT_FB:-1337}
PORT_SM=${PORT_SM:-2337}
STATE_FILE="${STATE_FILE:-/tmp/${USER}_jupyter_${PORT_NB}_${PORT_FB}_${PORT_SM}.info}"

[[ -f "$STATE_FILE" ]] && rm "$STATE_FILE"

SRUN_ARGS="--account rigi --qos h100_rigi_high --exclusive --mem 0 --gpus-per-node 8 --time 7-00:00:00"

# Create a wrapper that prints hostname first, then runs the script
srun $SRUN_ARGS --output="$STATE_FILE" --open-mode=append \
  bash -c "
    echo \$(hostname -f)
    PORT_NB=$PORT_NB PORT_FB=$PORT_FB PORT_SM=$PORT_SM ~/rigi/devbox_inner
    sleep infinity
  " &
SRUN_PID=$!


# Wait until the file has the host/port
until read -r host 2>/dev/null < "$STATE_FILE"; do sleep 0.5; done
echo "Job running, you can go there and attach using:"
echo -e "\033[34mssh $host -t tmux -L inner a\033[0m"

ssh -N -f -L ":$PORT_NB:localhost:$PORT_NB" -L ":$PORT_FB:localhost:$PORT_FB" -L ":$PORT_SM:localhost:$PORT_SM" "$host"
echo "Ports $PORT_NB,$PORT_FB,$PORT_SM forwarded. If you need to forward to laptop, run:"
echo "ssh -N -f -L localhost:$PORT_NB:localhost:$PORT_NB -L localhost:$PORT_FB:localhost:$PORT_FB -L localhost:$PORT_SM:localhost:$PORT_SM fair-sc-3"
echo "ssh -N -f -L localhost:$((PORT_NB+1)):localhost:$PORT_NB -L localhost:$((PORT_FB+1)):localhost:$PORT_FB -L localhost:$((PORT_SM+1)):localhost:$PORT_SM fair-sc"

WAIT=${WAIT:-no}
case "${WAIT,,}" in
  1|true|yes|y|on) WAIT=1 ;;
  0|false|no|n|off|'') WAIT=0 ;;
esac

if [ "$WAIT" -eq 1 ]; then
  echo "If you Ctrl+C, we'll also kill the slurm job... (run with WAIT=no to disable waiting)"
  trap "kill $SRUN_PID 2>/dev/null; exit 0" INT TERM
  wait $SRUN_PID
fi
